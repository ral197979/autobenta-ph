generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  buyer
  seller
  dealer
  inspector
  admin
}

enum ListingStatus {
  draft
  pending
  active
  sold
  archived
  rejected
  flagged
}

enum InquiryStatus {
  new
  contacted
  viewing_scheduled
  financing
  closed_won
  closed_lost
  qualified
  test_drive_scheduled
  negotiating
}

enum InspectionStatus {
  requested
  scheduled
  in_progress
  completed
  cancelled
}

enum InspectionResult {
  pass
  warning
  fail
}

enum FinancingStatus {
  requested
  prequalified
  docs_needed
  approved
  rejected
}

enum FuelType {
  gasoline
  diesel
  hybrid
  electric
  lpg
}

enum Transmission {
  automatic
  manual
  cvt
}

enum SellerType {
  private
  dealer
  repossessed
}

enum ConditionGrade {
  excellent
  good
  fair
  poor
}

enum ModerationAction {
  approve
  reject
  flag
  request_info
  escalate
  suspend_seller
  restore
}

enum FraudFlagSeverity {
  low
  medium
  high
  critical
}

enum ApplicationStatus {
  draft
  submitted
  under_review
  approved
  rejected
}

enum DealerActivityType {
  lead_created
  lead_updated
  note_added
  reminder_set
  listing_created
  listing_sold
  inquiry_received
  financing_requested
  call_made
  sms_sent
  email_sent
  meeting_held
  test_drive_completed
  automation_triggered
}

enum SubscriptionPlan {
  free
  verified
  pro
  enterprise
}

enum DealerTier {
  basic
  verified
  verified_pro
  enterprise
}

enum VerificationType {
  seller_identity
  dealer_business
  ownership
  vehicle
  transfer_readiness
}

enum VerificationStatus {
  pending
  under_review
  approved
  rejected
  expired
  suspended
}

enum DocumentType {
  government_id
  selfie
  or_cr
  deed_of_sale
  business_registration
  dealer_permit
  proof_of_address
  insurance_policy
  inspection_report
  other
}

enum DealerSourceType {
  MANUAL
  CSV
  V8ATLAS
  API
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role     @default(buyer)
  isVerified    Boolean  @default(false)
  isActive      Boolean  @default(true)
  isSuspended   Boolean  @default(false)
  suspendReason String?
  avatarUrl     String?
  lastLoginAt   DateTime?
  loginCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Verification
  verificationScore   Int?
  verificationExpiry  DateTime?

  dealer              Dealer?
  dealerApplication   DealerApplication?
  listings            VehicleListing[]
  favorites           Favorite[]
  inquiriesSent       Inquiry[]         @relation("BuyerInquiries")
  offersMade          Offer[]           @relation("BuyerOffers")
  offersReceived      Offer[]           @relation("SellerOffers")
  reviewsReceived     Review[]          @relation("SellerReviews")
  reviewsWritten      Review[]          @relation("ReviewsWritten")
  messagesSent        Message[]         @relation("MessagesSent")
  disputesFiled       Dispute[]         @relation("DisputesFiled")
  inspectionRequests  InspectionRequest[]
  financingRequests   FinancingRequest[]
  auditLogs           AuditLog[]
  sellerRiskProfile   SellerRiskProfile?
  recentlyViewed      RecentlyViewed[]
  savedSearches       SavedSearch[]
  verificationRequests VerificationRequest[]
  verificationReviews  VerificationReview[]
  dealerMemberships    DealerMember[]
  events              MarketplaceEvent[]

  @@map("users")
}

model Dealer {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  description   String?
  address       String
  city          String
  logoUrl       String?
  website       String?
  licenseNumber String?
  isVerified    Boolean        @default(false)
  tier          DealerTier     @default(basic)
  avgResponseHours Float?
  totalLeads    Int            @default(0)
  totalWon      Int            @default(0)

  // Lifecycle tracking
  firstListingAt  DateTime?
  firstLeadAt     DateTime?
  firstSaleAt     DateTime?
  onboardingStep  Int          @default(0)   // 0-5 steps completed
  sourceType      DealerSourceType @default(MANUAL)
  integrationMeta Json?            // stores provider-specific config (api keys, sync timestamps, etc.)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listings         VehicleListing[]
  leads            Lead[]
  activities       DealerActivity[]
  reminders        DealerReminder[]
  branches         DealerBranch[]
  members          DealerMember[]
  subscription     DealerSubscription?
  events           MarketplaceEvent[]
  dealerMetrics    DealerMetrics?
  application      DealerApplication?
  invoices         Invoice[]
  closingInvoices  ClosingInvoice[]
  successScore     DealerSuccessScore?
  churnRisks       ChurnRisk[]
  caseStudies      CaseStudy[]
  usageMetrics     UsageMetric[]
  automationRules  AutomationRule[]
  featuredListings FeaturedListing[]
  leadCredits      LeadCredit?
  successPlan      DealerSuccessPlan?
  timeToValue      TimeToValue?
  adoptionSnapshots AdoptionSnapshot[]
  csTasks          CustomerSuccessTask[]
  renewalReadiness RenewalReadiness?
  apiKeys          DealerApiKey[]
  webhooks         DealerWebhook[]

  @@map("dealers")
}

model VehicleListing {
  id             String         @id @default(uuid())
  sellerId       String
  seller         User           @relation(fields: [sellerId], references: [id])
  dealerId       String?
  dealer         Dealer?        @relation(fields: [dealerId], references: [id])
  sellerType     SellerType     @default(private)
  inventorySource DealerSourceType? // which system this listing came from
  externalId      String?           // ID in the source system (e.g. V8Atlas vehicle ID)
  status         ListingStatus  @default(draft)

  make           String
  model          String
  year           Int
  variant        String?
  plateEnding    String?
  mileage        Int
  price          Decimal        @db.Decimal(12, 2)
  negotiable     Boolean        @default(true)

  fuelType       FuelType       @default(gasoline)
  transmission   Transmission   @default(automatic)
  color          String?
  bodyType       String?

  location       String
  city           String
  region         String
  lat            Float?
  lng            Float?

  condition      ConditionGrade @default(good)
  description    String?

  hasOrCr        Boolean        @default(true)
  orCrNotes      String?
  ownerCount     Int            @default(1)
  serviceHistory Boolean        @default(false)
  serviceNotes   String?
  hasAccident    Boolean        @default(false)
  accidentNotes  String?
  hasFlood       Boolean        @default(false)
  floodNotes     String?

  viewCount      Int            @default(0)
  inquiryCount   Int            @default(0)
  favoriteCount  Int            @default(0)
  isSponsored    Boolean        @default(false)
  featuredUntil  DateTime?

  // Trust & transfer readiness fields
  ownershipVerified      Boolean  @default(false)
  transferReady          Boolean  @default(false)
  vehicleHistoryAvailable Boolean @default(false)
  sellerVerified         Boolean  @default(false)
  priceScore             Int?     // 0–100 AI price score
  financingEligible      Boolean  @default(false)

  // Readiness Score V2 — backend-calculated
  readinessScore         Int?     // 0–100, computed by backend
  readinessReason        Json?    // breakdown of criteria
  readinessEvaluatedAt   DateTime?

  // AI vision draft metadata
  aiDraftData    Json?
  searchVector   String?        // denormalized search text

  fraudFlags     Json?
  fraudScore     Int?           @default(0)
  moderationNote String?
  aiAnalysisId   String?

  listedAt       DateTime?      // when first activated
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  soldAt         DateTime?

  photos               VehiclePhoto[]
  favorites            Favorite[]
  inquiries            Inquiry[]
  offers               Offer[]
  inspectionRequests   InspectionRequest[]
  financingRequests    FinancingRequest[]
  aiAnalyses           AIAnalysis[]
  leads                Lead[]
  fraudFlagRecords     FraudFlag[]
  moderationActions    ListingModerationAction[]
  recentlyViewed       RecentlyViewed[]
  verificationRequests VerificationRequest[]
  events               MarketplaceEvent[]
  metrics              ListingMetrics?
  featuredListings     FeaturedListing[]

  @@unique([externalId, dealerId])
  @@index([status])
  @@index([make, model])
  @@index([city])
  @@index([price])
  @@index([year])
  @@index([mileage])
  @@index([createdAt])
  @@index([sellerId])
  @@index([dealerId])
  @@index([fraudScore])
  @@map("vehicle_listings")
}

model VehiclePhoto {
  id         String   @id @default(uuid())
  listingId  String
  listing    VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url        String
  storageKey String?          // R2/S3 object key for deletion
  provider   String  @default("local")
  isPrimary  Boolean @default(false)
  caption    String?
  sortOrder  Int     @default(0)
  width      Int?
  height     Int?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  @@map("vehicle_photos")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("favorites")
}

model Inquiry {
  id          String        @id @default(uuid())
  buyerId     String
  buyer       User          @relation("BuyerInquiries", fields: [buyerId], references: [id])
  listingId   String
  listing     VehicleListing @relation(fields: [listingId], references: [id])
  message     String
  contactPhone String?
  status      InquiryStatus @default(new)
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lead Lead?
  messages Message[]

  @@map("inquiries")
}

model Offer {
  id            String         @id @default(uuid())
  listingId     String
  listing       VehicleListing @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User           @relation("BuyerOffers", fields: [buyerId], references: [id])
  sellerId      String
  seller        User           @relation("SellerOffers", fields: [sellerId], references: [id])
  amount        Decimal        @db.Decimal(12, 2)
  counterAmount Decimal?       @db.Decimal(12, 2)
  message       String?
  status        OfferStatus    @default(pending)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("offers")
}

enum OfferStatus {
  pending
  countered
  accepted
  declined
  withdrawn
}

model Review {
  id         String         @id @default(uuid())
  sellerId   String
  seller     User           @relation("SellerReviews", fields: [sellerId], references: [id])
  reviewerId String
  reviewer   User           @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  listingId  String?
  rating     Int
  comment    String?
  createdAt  DateTime       @default(now())

  @@map("reviews")
}

model Message {
  id        String   @id @default(uuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id])
  senderId  String
  sender    User     @relation("MessagesSent", fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@map("messages")
}

model Dispute {
  id          String        @id @default(uuid())
  reporterId  String
  reporter    User          @relation("DisputesFiled", fields: [reporterId], references: [id])
  listingId   String?
  category    String
  subject     String
  description String
  status      DisputeStatus @default(open)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("disputes")
}

enum DisputeStatus {
  open
  under_review
  resolved
  dismissed
}

model Lead {
  id         String        @id @default(uuid())
  dealerId   String
  dealer     Dealer        @relation(fields: [dealerId], references: [id])
  inquiryId  String?       @unique
  inquiry    Inquiry?      @relation(fields: [inquiryId], references: [id])
  listingId  String
  listing    VehicleListing @relation(fields: [listingId], references: [id])
  buyerName  String
  buyerEmail String?
  buyerPhone String?
  status          InquiryStatus @default(new)
  notes           String?
  source          String?       @default("inquiry") // inquiry, direct, referral, walk-in
  lostReason      String?
  closedAt        DateTime?
  assignedUserId  String?
  nextFollowUpAt  DateTime?
  leadScore       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  activities DealerActivity[]

  @@index([dealerId, status])
  @@map("leads")
}

model InspectionRequest {
  id          String           @id @default(uuid())
  buyerId     String
  buyer       User             @relation(fields: [buyerId], references: [id])
  listingId   String
  listing     VehicleListing   @relation(fields: [listingId], references: [id])
  status      InspectionStatus @default(requested)
  preferredDate DateTime?
  address     String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  report InspectionReport?

  @@map("inspection_requests")
}

model InspectionReport {
  id          String           @id @default(uuid())
  requestId   String           @unique
  request     InspectionRequest @relation(fields: [requestId], references: [id])
  inspectorId String?
  overallScore Int
  result      InspectionResult

  exterior      Json
  interior      Json
  engine        Json
  transmission  Json
  suspension    Json
  tires         Json
  electrical    Json
  floodSigns    Json
  accidentSigns Json
  testDriveNotes String?

  photos      Json?
  isPublic    Boolean  @default(true)
  inspectedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("inspection_reports")
}

model FinancingRequest {
  id             String          @id @default(uuid())
  buyerId        String
  buyer          User            @relation(fields: [buyerId], references: [id])
  listingId      String
  listing        VehicleListing  @relation(fields: [listingId], references: [id])
  status         FinancingStatus @default(requested)
  vehiclePrice   Decimal         @db.Decimal(12, 2)
  downPayment    Decimal         @db.Decimal(12, 2)
  loanAmount     Decimal         @db.Decimal(12, 2)
  termMonths     Int
  monthlyPayment Decimal?        @db.Decimal(12, 2)
  incomeRange    String
  employmentType String?
  adminNotes     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("financing_requests")
}

model AIAnalysis {
  id               String   @id @default(uuid())
  listingId        String
  listing          VehicleListing @relation(fields: [listingId], references: [id])
  estimatedPrice   Decimal? @db.Decimal(12, 2)
  priceLow         Decimal? @db.Decimal(12, 2)
  priceHigh        Decimal? @db.Decimal(12, 2)
  listingScore     Int?
  fraudScore       Int?
  fraudFlags       Json?
  qualityFlags     Json?
  buyerChecklist   Json?
  negotiationTips  Json?
  summary          String?
  model            String   @default("mock")
  createdAt        DateTime @default(now())

  @@map("ai_analyses")
}

// ─── Phase 2: Fraud & Moderation ─────────────────────────────────────────────

model FraudFlag {
  id          String            @id @default(uuid())
  listingId   String
  listing     VehicleListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  flagType    String            // price_too_low, duplicate_listing, suspicious_seller, etc.
  severity    FraudFlagSeverity @default(medium)
  title       String
  description String
  metadata    Json?
  isResolved  Boolean           @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  resolveNote String?
  autoDetected Boolean          @default(true)
  createdAt   DateTime          @default(now())

  @@index([listingId])
  @@index([flagType])
  @@index([severity])
  @@index([isResolved])
  @@map("fraud_flags")
}

model SellerRiskProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskScore        Int      @default(0)       // 0–100
  riskLevel        String   @default("low")   // low, medium, high, critical
  flags            Json?
  totalListings    Int      @default(0)
  flaggedListings  Int      @default(0)
  rapidListings    Boolean  @default(false)   // >5 listings in 24h
  duplicateHistory Boolean  @default(false)
  suspiciousEdits  Int      @default(0)
  lastCalculated   DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("seller_risk_profiles")
}

model ListingModerationAction {
  id          String           @id @default(uuid())
  listingId   String
  listing     VehicleListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  adminId     String
  action      ModerationAction
  reason      String?
  details     Json?
  previousStatus String?
  newStatus      String?
  createdAt   DateTime         @default(now())

  @@index([listingId])
  @@index([adminId])
  @@index([action])
  @@map("listing_moderation_actions")
}

// ─── Phase 2: Discovery ───────────────────────────────────────────────────────

model SavedSearch {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  filters    Json
  alertOn    Boolean  @default(false)
  lastRun    DateTime?
  resultCount Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("saved_searches")
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@map("recently_viewed")
}

// ─── Phase 2: Dealer Operations ───────────────────────────────────────────────

model DealerActivity {
  id          String             @id @default(uuid())
  dealerId    String
  dealer      Dealer             @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?              @relation(fields: [leadId], references: [id])
  actorId     String?
  type        DealerActivityType
  description String
  metadata    Json?
  createdAt   DateTime           @default(now())

  @@index([dealerId])
  @@index([leadId])
  @@map("dealer_activities")
}

model DealerReminder {
  id          String   @id @default(uuid())
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  leadId      String?
  title       String
  dueAt       DateTime
  isDone      Boolean  @default(false)
  doneAt      DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([dealerId, isDone])
  @@index([dueAt])
  @@map("dealer_reminders")
}

// ─── Phase 2: Audit Infrastructure ───────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  prevHash    String?  // chain link
  hash        String?  // SHA-256 of this record
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AuditHashAnchor {
  id        String   @id @default(uuid())
  sequence  Int      @unique
  hash      String
  logId     String?
  createdAt DateTime @default(now())

  @@map("audit_hash_anchors")
}

// ─── Phase 4: Dealer Network ──────────────────────────────────────────────────

model DealerBranch {
  id        String   @id @default(uuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name      String
  address   String
  city      String
  region    String
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerId])
  @@map("dealer_branches")
}

model DealerSubscription {
  id           String           @id @default(uuid())
  dealerId     String           @unique
  dealer       Dealer           @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @default(free)
  status       String           @default("active")  // active | cancelled | expired | trial
  startedAt    DateTime         @default(now())
  expiresAt    DateTime?
  billingCycle String?          // monthly | annual
  features     Json?            // entitlement flags: { maxListings, analytics, crm, priorityPlacement, v8atlasSync, multiBranch }
  trialEndsAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("dealer_subscriptions")
}

model DealerMember {
  id        String   @id @default(uuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("agent")  // owner | manager | agent
  isActive  Boolean  @default(true)
  invitedAt DateTime @default(now())
  joinedAt  DateTime?

  @@unique([dealerId, userId])
  @@index([dealerId])
  @@index([userId])
  @@map("dealer_members")
}

// ─── Phase 3: Verification Engine ─────────────────────────────────────────────

model VerificationRequest {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId        String?
  listing          VehicleListing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  verificationType VerificationType
  status           VerificationStatus @default(pending)
  submittedAt      DateTime           @default(now())
  expiresAt        DateTime?
  rejectionReason  String?
  adminNotes       String?
  verificationScore Int?              // 0–100 computed on approval
  metadata         Json?              // extra context per type

  documents   VerificationDocument[]
  reviews     VerificationReview[]
  statusHistory VerificationStatusHistory[]

  @@index([userId])
  @@index([listingId])
  @@index([verificationType])
  @@index([status])
  @@index([submittedAt])
  @@map("verification_requests")
}

model VerificationDocument {
  id            String              @id @default(uuid())
  requestId     String
  request       VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentType  DocumentType
  url           String
  storageKey    String?
  provider      String              @default("local")
  fileName      String?
  sizeBytes     Int?
  mimeType      String?
  isConfidential Boolean            @default(true)
  uploadedAt    DateTime            @default(now())

  @@index([requestId])
  @@index([documentType])
  @@map("verification_documents")
}

model VerificationReview {
  id          String              @id @default(uuid())
  requestId   String
  request     VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User                @relation(fields: [reviewerId], references: [id])
  action      VerificationStatus
  notes       String?
  reviewedAt  DateTime            @default(now())

  @@index([requestId])
  @@index([reviewerId])
  @@map("verification_reviews")
}

model VerificationStatusHistory {
  id          String              @id @default(uuid())
  requestId   String
  request     VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  VerificationStatus?
  toStatus    VerificationStatus
  changedBy   String?
  reason      String?
  changedAt   DateTime            @default(now())

  @@index([requestId])
  @@map("verification_status_history")
}

// ─── Phase 4: Marketplace Analytics ──────────────────────────────────────────

enum EventType {
  LISTING_VIEW
  LISTING_SAVE
  LISTING_SHARE
  SELLER_CONTACT
  FINANCING_REQUEST
  INSPECTION_REQUEST
  TRANSFER_CHECKLIST_STARTED
  TRANSFER_CHECKLIST_COMPLETED
  VEHICLE_HISTORY_VIEWED
  SAFE_BUYING_VIEWED
  VERIFICATION_VIEWED
  LEAD_CREATED
  LEAD_CONVERTED
  DEALER_PAGE_VIEW
  SEARCH_PERFORMED
  FILTER_APPLIED
  SALE_RECORDED
}

model MarketplaceEvent {
  id             String    @id @default(cuid())
  eventType      EventType
  userId         String?
  sessionId      String
  listingId      String?
  dealerId       String?
  source         String?   // organic, google, facebook, direct, referral, dealer_campaign, marketplace_search
  device         String?
  referrer       String?
  meta           Json?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  listing VehicleListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  dealer  Dealer?         @relation(fields: [dealerId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([listingId, eventType])
  @@index([dealerId, eventType])
  @@index([sessionId])
  @@index([createdAt])
  @@map("marketplace_events")
}

model ListingMetrics {
  id               String         @id @default(cuid())
  listingId        String         @unique
  listing          VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewCount        Int            @default(0)
  saveCount        Int            @default(0)
  shareCount       Int            @default(0)
  inquiryCount     Int            @default(0)
  financingCount   Int            @default(0)
  inspectionCount  Int            @default(0)
  performanceScore Int            @default(0)
  lastCalculatedAt DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("listing_metrics")
}

model DealerMetrics {
  id                String   @id @default(cuid())
  dealerId          String   @unique
  dealer            Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  totalLeads        Int      @default(0)
  convertedLeads    Int      @default(0)
  avgResponseTimeMs Int?
  totalListings     Int      @default(0)
  activeListings    Int      @default(0)
  totalViews        Int      @default(0)
  totalInquiries    Int      @default(0)
  performanceScore  Int      @default(0)
  lastCalculatedAt  DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("dealer_metrics")
}

model AnalyticsSnapshot {
  id               String   @id @default(cuid())
  snapshotDate     DateTime @unique
  totalListings    Int      @default(0)
  activeListings   Int      @default(0)
  verifiedListings Int      @default(0)
  transferReady    Int      @default(0)
  totalDealers     Int      @default(0)
  leadVolume       Int      @default(0)
  inspectionVolume Int      @default(0)
  financingVolume  Int      @default(0)
  transferVolume   Int      @default(0)
  newUsers         Int      @default(0)
  eventVolume      Int      @default(0)
  createdAt        DateTime @default(now())

  @@map("analytics_snapshots")
}

model ConversionFunnel {
  id           String   @id @default(cuid())
  periodStart  DateTime
  periodEnd    DateTime
  visitors     Int      @default(0)
  searches     Int      @default(0)
  listingViews Int      @default(0)
  inquiries    Int      @default(0)
  inspections  Int      @default(0)
  financing    Int      @default(0)
  transfers    Int      @default(0)
  sales        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([periodStart, periodEnd])
  @@map("conversion_funnels")
}

// ─── Phase 5: Dealer Growth Platform ─────────────────────────────────────────

model DealerApplication {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealerId        String?           @unique
  dealer          Dealer?           @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  status          ApplicationStatus @default(draft)

  // Step 1: Business info
  businessName    String?
  businessType    String?           // independent | multi_location | enterprise
  contactName     String?
  contactPhone    String?
  address         String?
  city            String?

  // Step 2: Documents (stored as JSON array of { documentType, url, storageKey })
  documents       Json?

  // Step 3: Subscription tier selected
  selectedPlan    String?           // free | verified | pro | enterprise

  // Admin review
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  adminNotes      String?

  submittedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@map("dealer_applications")
}

model Invoice {
  id             String   @id @default(uuid())
  dealerId       String
  dealer         Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  invoiceNumber  String   @unique
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("PHP")
  status         String   @default("pending")  // pending | paid | failed | refunded | void
  plan           String?
  billingCycle   String?  // monthly | annual
  periodStart    DateTime?
  periodEnd      DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments PaymentRecord[]

  @@index([dealerId])
  @@index([status])
  @@map("invoices")
}

model PaymentRecord {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  dealerId      String
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("PHP")
  processor     String   // stripe | gcash | maya | bank_transfer | manual
  processorRef  String?  // external transaction ID
  status        String   @default("pending")  // pending | success | failed | refunded
  metadata      Json?
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([dealerId])
  @@map("payment_records")
}

model UsageMetric {
  id         String   @id @default(uuid())
  dealerId   String
  dealer     Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  metricType String   // active_listings | api_calls | lead_routing | exports
  value      Int      @default(0)
  period     String   // YYYY-MM for monthly snapshots
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([dealerId, metricType, period])
  @@index([dealerId, period])
  @@map("usage_metrics")
}

// ─── CRM & Revenue Activation ────────────────────────────────────────────────

model AutomationRule {
  id          String   @id @default(uuid())
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name        String
  trigger     String   // lead_created | no_response_24h | no_response_72h | financing_requested | inspection_requested
  conditions  Json?    // e.g. { source: 'inquiry' }
  actions     Json     // array of { type: 'add_note'|'set_status'|'create_reminder', payload }
  isActive    Boolean  @default(true)
  runCount    Int      @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dealerId, isActive])
  @@map("automation_rules")
}

model FeaturedListing {
  id          String   @id @default(uuid())
  listingId   String
  listing     VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  featureType String   // homepage | search_boost | featured_dealer | sponsored
  startAt     DateTime @default(now())
  endAt       DateTime
  pricePhp    Decimal  @db.Decimal(10, 2)
  status      String   @default("pending") // pending | active | expired | cancelled
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([listingId])
  @@index([dealerId])
  @@index([status, endAt])
  @@map("featured_listings")
}

model LeadCredit {
  id              String   @id @default(uuid())
  dealerId        String   @unique
  dealer          Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  balance         Int      @default(0)
  lifetimeCredits Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions CreditTransaction[]

  @@map("lead_credits")
}

model CreditPackage {
  id        String   @id @default(uuid())
  name      String
  credits   Int
  pricePhp  Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("credit_packages")
}

model CreditTransaction {
  id            String      @id @default(uuid())
  dealerId      String
  creditId      String
  credit        LeadCredit  @relation(fields: [creditId], references: [id], onDelete: Cascade)
  packageId     String?
  leadId        String?
  type          String      // purchase | consumption | refund | bonus | manual_adjustment
  credits       Int         // positive for additions, negative for consumption
  balanceBefore Int
  balanceAfter  Int
  description   String?
  createdAt     DateTime    @default(now())

  @@index([dealerId])
  @@index([creditId])
  @@map("credit_transactions")
}

// ─── Job Queue ────────────────────────────────────────────────────────────────

enum JobStatus {
  pending
  processing
  completed
  failed
  dead
}

model JobQueue {
  id           String    @id @default(uuid())
  type         String    // lead_sync | inventory_sync | trust_sync | webhook_retry
  payload      Json
  status       JobStatus @default(pending)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  scheduledAt  DateTime  @default(now())
  processedAt  DateTime?
  completedAt  DateTime?
  lastError    String?
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([type, status])
  @@map("job_queue")
}

// ─── Dealer Acquisition Engine ────────────────────────────────────────────────

enum ProspectStage {
  prospect
  contacted
  demo_scheduled
  demo_completed
  proposal_sent
  negotiating
  won
  lost
}

enum DemoType {
  marketplace
  crm
  v8atlas
  full_platform
}

enum DemoStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum FeedbackCategory {
  onboarding
  crm
  listings
  leads
  billing
  general
}

enum FeatureRequestStatus {
  open
  planned
  in_progress
  shipped
  declined
}

enum RenewalLikelihood {
  high
  medium
  low
  at_risk
  unknown
}

enum RiskLevel {
  low
  medium
  high
  critical
}

model DealerProspect {
  id               String         @id @default(cuid())
  dealerName       String
  contactName      String
  phone            String?
  email            String?
  location         String?
  branches         Int            @default(1)
  inventorySize    String?
  currentSystem    String?
  source           String?
  stage            ProspectStage  @default(prospect)
  owner            String?
  lastContactAt    DateTime?
  nextFollowUpAt   DateTime?
  status           String         @default("active")
  expectedMrr      Int?
  closeProbability Int            @default(10)
  // Qualification scoring fields
  monthlyVehiclesSold  Int?
  salesTeamSize        Int?
  currentDms           String?   // 'none','cdk','reynolds','dealersocket','excel','custom','unknown'
  currentLeadProcess   String?   // 'none','excel','facebook_manual','crm','other'
  painLevel            Int?      // 1-5 (1=mild, 5=critical)
  buyingTimeline       String?   // 'immediate','1_month','3_months','6_months','unknown'
  decisionMakerAccess  Boolean   @default(false)
  budgetRange          String?   // 'confirmed','likely','unknown','constrained'
  qualificationScore   Int?      // auto-calculated 0-100
  qualificationTier    String?   // 'hot','warm','cold','unqualified'
  notes            String?
  lostReason       String?
  wonAt            DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Closing kit fields
  closingStage     String?
  nextAction       String?
  riskFlags        String[]       @default([])
  ownedBy          String?

  activities       ProspectActivity[]
  demoBookings     DemoBooking[]
  proposals        Proposal[]
}

model ProspectActivity {
  id          String         @id @default(cuid())
  prospectId  String
  prospect    DealerProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type        String
  content     String
  createdBy   String?
  createdAt   DateTime       @default(now())
}

model DemoBooking {
  id              String          @id @default(cuid())
  prospectId      String?
  prospect        DealerProspect? @relation(fields: [prospectId], references: [id])
  name            String
  company         String
  email           String
  phone           String?
  inventoryCount  String?
  currentProcess  String?
  challenges      String?
  demoType        DemoType        @default(full_platform)
  scheduledAt     DateTime
  status          DemoStatus      @default(pending)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model CompetitorProfile {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  pricing     String?
  strengths   Json     @default("[]")
  weaknesses  Json     @default("[]")
  objections  Json     @default("[]")
  positioning String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DealerSuccessPlan {
  id                   String            @id @default(cuid())
  dealerId             String            @unique
  dealer               Dealer            @relation(fields: [dealerId], references: [id])
  inventoryImported    Boolean           @default(false)
  firstListingLive     Boolean           @default(false)
  firstLeadReceived    Boolean           @default(false)
  firstLeadResponded   Boolean           @default(false)
  firstSaleReported    Boolean           @default(false)
  subscriptionActive   Boolean           @default(false)
  crmAdoptionRate      Float?
  renewalLikelihood    RenewalLikelihood @default(unknown)
  riskLevel            RiskLevel         @default(low)
  thirtyDayScore       Int?
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model FeatureRequest {
  id            String               @id @default(cuid())
  dealerId      String?
  title         String
  description   String
  frequency     Int                  @default(1)
  priority      String               @default("low")
  revenueImpact Int?
  status        FeatureRequestStatus @default(open)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model DealerFeedback {
  id        String           @id @default(cuid())
  dealerId  String?
  category  FeedbackCategory @default(general)
  rating    Int?
  content   String
  createdAt DateTime         @default(now())
}

model SupportTicket {
  id          String         @id @default(cuid())
  dealerId    String?
  subject     String
  description String
  category    String         @default("general")
  priority    TicketPriority @default(normal)
  status      TicketStatus   @default(open)
  resolution  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model NPSResponse {
  id        String   @id @default(cuid())
  dealerId  String?
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}

// ─── Dealer Closing Kit ───────────────────────────────────────────────────────

model Proposal {
  id               String         @id @default(cuid())
  dealerProspectId String
  dealerProspect   DealerProspect @relation(fields: [dealerProspectId], references: [id])
  dealerName       String
  contactName      String
  location         String?
  currentProcess   String?
  painPoints       String?
  recommendedPlan  String         @default("founding_dealer")
  monthlyVehicles  Int?
  avgGrossProfit   Int?
  projectedLeads   Int?
  roiEstimate      Json?
  pricingMonthly   Int            @default(3599)
  discount         Int            @default(0)
  status           String         @default("draft")
  sentAt           DateTime?
  viewedAt         DateTime?
  acceptedAt       DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  agreement        Agreement?
}

model Agreement {
  id           String    @id @default(cuid())
  proposalId   String    @unique
  proposal     Proposal  @relation(fields: [proposalId], references: [id])
  version      String    @default("1.0")
  status       String    @default("generated")
  generatedAt  DateTime  @default(now())
  sentAt       DateTime?
  viewedAt     DateTime?
  signedAt     DateTime?
  signerName   String?
  signerEmail  String?
  signerTitle  String?
  auditLog     Json      @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  invoice      ClosingInvoice?
}

model ClosingInvoice {
  id            String     @id @default(cuid())
  agreementId   String?    @unique
  agreement     Agreement? @relation(fields: [agreementId], references: [id])
  dealerId      String?
  dealer        Dealer?    @relation(fields: [dealerId], references: [id])
  invoiceNumber String     @unique
  dealerName    String
  dealerEmail   String
  planName      String     @default("Founding Dealer Plan")
  billingPeriod String
  amount        Int
  discount      Int        @default(0)
  totalAmount   Int
  status        String     @default("draft")
  issuedAt      DateTime?
  dueDate       DateTime?
  paidAt        DateTime?
  paymentMethod String?
  paymentRef    String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model DealerSuccessScore {
  id               String   @id @default(cuid())
  dealerId         String   @unique
  dealer           Dealer   @relation(fields: [dealerId], references: [id])
  loginFrequency   Int      @default(0)
  listingsAdded    Int      @default(0)
  leadResponseRate Float    @default(0)
  crmUsageScore    Int      @default(0)
  inventoryQuality Int      @default(0)
  supportRequests  Int      @default(0)
  totalScore       Int      @default(0)
  healthStatus     String   @default("watch")
  calculatedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ChurnRisk {
  id                String    @id @default(cuid())
  dealerId          String
  dealer            Dealer    @relation(fields: [dealerId], references: [id])
  riskScore         Int
  triggers          Json      @default("[]")
  recommendedAction String?
  status            String    @default("open")
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CaseStudy {
  id                  String    @id @default(cuid())
  dealerId            String
  dealer              Dealer    @relation(fields: [dealerId], references: [id])
  title               String
  summary             String?
  leadsGenerated      Int?
  responseImprovement String?
  crmAdoption         String?
  revenueImpact       String?
  timeSaved           String?
  testimonial         String?
  status              String    @default("draft")
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─── Dealer Success System ────────────────────────────────────────────────────

model TimeToValue {
  id                    String    @id @default(cuid())
  dealerId              String    @unique
  dealer                Dealer    @relation(fields: [dealerId], references: [id])
  agreementSignedAt     DateTime?
  invoicePaidAt         DateTime?
  firstLoginAt          DateTime?
  firstListingAt        DateTime?
  firstLeadAt           DateTime?
  firstResponseAt       DateTime?
  firstQualifiedLeadAt  DateTime?
  firstSaleAt           DateTime?
  daysToFirstLogin      Int?
  daysToFirstListing    Int?
  daysToFirstLead       Int?
  daysToFirstResponse   Int?
  daysToFirstSale       Int?
  bottleneck            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model AdoptionSnapshot {
  id                 String   @id @default(cuid())
  dealerId           String
  dealer             Dealer   @relation(fields: [dealerId], references: [id])
  weekNumber         Int
  year               Int
  logins             Int      @default(0)
  listingsAdded      Int      @default(0)
  leadsUpdated       Int      @default(0)
  crmNotesAdded      Int      @default(0)
  pipelineMovements  Int      @default(0)
  analyticsViews     Int      @default(0)
  lowAdoptionAlert   Boolean  @default(false)
  alertReason        String?
  createdAt          DateTime @default(now())

  @@unique([dealerId, weekNumber, year])
}

model CustomerSuccessTask {
  id           String    @id @default(cuid())
  dealerId     String
  dealer       Dealer    @relation(fields: [dealerId], references: [id])
  dayNumber    Int
  taskType     String
  title        String
  description  String
  dueDate      DateTime
  status       String    @default("pending")
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model RenewalReadiness {
  id                    String    @id @default(cuid())
  dealerId              String    @unique
  dealer                Dealer    @relation(fields: [dealerId], references: [id])
  renewalDate           DateTime?
  daysUntilRenewal      Int?
  healthReviewDone      Boolean   @default(false)
  usageReviewDone       Boolean   @default(false)
  roiReviewDone         Boolean   @default(false)
  expansionOpportunity  String?
  renewalProposalSent   Boolean   @default(false)
  renewalConfirmed      Boolean   @default(false)
  readinessScore        Int       @default(0)
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ─── API Keys & Webhooks ──────────────────────────────────────────────────────

model DealerApiKey {
  id          String    @id @default(cuid())
  dealerId    String
  dealer      Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String    @unique
  keyPrefix   String
  permissions String[]  @default(["inventory:write","leads:read"])
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("dealer_api_keys")
}

model DealerWebhook {
  id          String    @id @default(cuid())
  dealerId    String
  dealer      Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  url         String
  events      String[]
  secret      String
  isActive    Boolean   @default(true)
  lastFiredAt DateTime?
  failCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("dealer_webhooks")
}

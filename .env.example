# ─── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/autobenta
JWT_SECRET=your-secret-key-min-32-chars
FRONTEND_URL=http://localhost:5173

# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
JWT_EXPIRES_IN=7d
LOG_LEVEL=info

# ─── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ─── AI Features ───────────────────────────────────────────────────────────────
AI_MODE=mock
# AI_MODE=openai requires:
# OPENAI_API_KEY=sk-...

# ─── V8Atlas Integration ───────────────────────────────────────────────────────
V8ATLAS_ENABLED=false
# V8ATLAS_ENABLED=true requires:
# V8ATLAS_BASE_URL=https://api.v8atlas.com
# V8ATLAS_API_KEY=your-api-key
# V8ATLAS_WEBHOOK_SECRET=your-webhook-secret

# ─── Storage Provider ──────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=r2 requires:
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=autobenta-uploads
# R2_PUBLIC_URL=https://...

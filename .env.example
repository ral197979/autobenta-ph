# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/autobenta_ph"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# AWS S3 (optional - leave blank to use local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=

# AI Service (optional - uses mock mode when blank)
OPENAI_API_KEY=
AI_MODE=mock
